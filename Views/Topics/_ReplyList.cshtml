@model Forum.ViewModels.TopicDetailsViewModel
<div id="reply-list">
@if (!Model.Replies.Any()) { <p class="empty-replies">Ответов пока нет.</p> }
@foreach (var reply in Model.Replies) { <article class="reply" data-reply-id="@reply.Id"><a class="reply-author" asp-controller="Profile" asp-action="Details" asp-route-id="@reply.AuthorId"><img src="@reply.Author.AvatarPath" alt="" /><span><strong>@reply.Author.UserName</strong><small>@reply.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · сообщений: @reply.Author.Replies.Count</small></span></a><p>@reply.Content</p><div class="votes"><button type="button" data-vote="1" title="Нравится" disabled="@(Model.CurrentUserId is null ? "disabled" : null)">▲ <span>@reply.Votes.Count(x => x.Value == 1)</span></button><button type="button" data-vote="-1" title="Не нравится" disabled="@(Model.CurrentUserId is null ? "disabled" : null)">▼ <span>@reply.Votes.Count(x => x.Value == -1)</span></button></div></article> }
</div>
<nav class="pagination reply-pages" data-topic="@Model.Topic.Id" aria-label="Страницы ответов">@for(var p=1;p<=Model.TotalPages;p++){<a class="@(p==Model.Page ? "active" : "")" href="@Url.Action("Details", new{id=Model.Topic.Id,page=p})" data-page="@p">@p</a>}</nav>
