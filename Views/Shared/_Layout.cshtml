<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · Forum</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><header class="site-header"><div class="shell nav"><a class="brand" asp-controller="Topics" asp-action="Index"><span>F</span> Forum</a><nav><a asp-controller="Topics" asp-action="Index">Темы</a>@if(User.Identity?.IsAuthenticated==true){<a asp-controller="Topics" asp-action="Create">Создать тему</a><span class="user-name">@User.Identity.Name</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="link-button">Выйти</button></form>}else{<a asp-controller="Account" asp-action="Login">Войти</a><a class="nav-cta" asp-controller="Account" asp-action="Register">Регистрация</a>}</nav></div></header><main class="shell">@RenderBody()</main><footer><div class="shell">Forum · Контрольная работа №8</div></footer>@await RenderSectionAsync("Scripts", required:false)</body></html>
